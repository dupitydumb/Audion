{
  "version": 2,
  "name": "Apple Music",
  "author": "Audion Community",
  "description": "Authentic Apple Music Cupertino experience following DESIGN.md with neutral chrome, red accents, SF typography, and frosted glass translucency.",
  "accentColor": "#FA243C",
  "mode": "dark",
  "customColors": {
    "bgBase": "#1E1E1E",
    "bgElevated": "#2A2A2C",
    "bgSurface": "#2A2A2C",
    "bgHighlight": "rgba(255, 255, 255, 0.10)",
    "textPrimary": "#FFFFFF",
    "textSecondary": "rgba(235, 235, 245, 0.60)",
    "textSubdued": "rgba(235, 235, 245, 0.30)",
    "borderColor": "rgba(255, 255, 255, 0.08)",
    "sidebarBg": "rgba(30, 30, 30, 0.72)",
    "playerBg": "rgba(30, 30, 30, 0.85)"
  },
  "background": {
    "type": "none",
    "value": "",
    "opacity": 1,
    "blur": 0,
    "fixed": false
  },
  "animation": {
    "reducedMotion": false,
    "pageTransition": "fade",
    "playerVisualization": "none",
    "hoverScale": false,
    "accentPulse": false,
    "transitionSpeed": "normal"
  },
  "activeScheme": "Dark",
  "schemes": {
    "Dark": {
      "name": "Dark",
      "mode": "dark",
      "accentColor": "#FA243C",
      "customColors": {
        "bgBase": "#1E1E1E",
        "bgElevated": "#2A2A2C",
        "bgSurface": "#2A2A2C",
        "bgHighlight": "rgba(255, 255, 255, 0.10)",
        "textPrimary": "#FFFFFF",
        "textSecondary": "rgba(235, 235, 245, 0.60)",
        "textSubdued": "rgba(235, 235, 245, 0.30)",
        "borderColor": "rgba(255, 255, 255, 0.08)",
        "sidebarBg": "rgba(30, 30, 30, 0.72)",
        "playerBg": "rgba(30, 30, 30, 0.85)"
      }
    },
    "Light": {
      "name": "Light",
      "mode": "light",
      "accentColor": "#FA243C",
      "customColors": {
        "bgBase": "#FFFFFF",
        "bgElevated": "#F6F6F6",
        "bgSurface": "#F6F6F6",
        "bgHighlight": "rgba(0, 0, 0, 0.06)",
        "textPrimary": "#1D1D1F",
        "textSecondary": "rgba(60, 60, 67, 0.60)",
        "textSubdued": "rgba(60, 60, 67, 0.30)",
        "borderColor": "rgba(0, 0, 0, 0.08)",
        "sidebarBg": "rgba(246, 246, 246, 0.78)",
        "playerBg": "rgba(246, 246, 246, 0.85)"
      }
    },
    "OLED Noir": {
      "name": "OLED Noir",
      "mode": "dark",
      "accentColor": "#FA243C",
      "customColors": {
        "bgBase": "#000000",
        "bgElevated": "#0D0D0E",
        "bgSurface": "#161618",
        "bgHighlight": "rgba(255, 255, 255, 0.08)",
        "textPrimary": "#FFFFFF",
        "textSecondary": "rgba(235, 235, 245, 0.60)",
        "textSubdued": "rgba(235, 235, 245, 0.30)",
        "borderColor": "rgba(255, 255, 255, 0.08)",
        "sidebarBg": "rgba(5, 5, 5, 0.85)",
        "playerBg": "rgba(10, 10, 10, 0.90)"
      }
    },
    "Classical": {
      "name": "Classical",
      "mode": "dark",
      "accentColor": "#D72638",
      "customColors": {
        "bgBase": "#121217",
        "bgElevated": "#1A1922",
        "bgSurface": "#23222E",
        "bgHighlight": "rgba(255, 255, 255, 0.08)",
        "textPrimary": "#F4F3F7",
        "textSecondary": "rgba(235, 235, 245, 0.60)",
        "textSubdued": "rgba(235, 235, 245, 0.30)",
        "borderColor": "rgba(255, 255, 255, 0.07)",
        "sidebarBg": "rgba(22, 21, 30, 0.78)",
        "playerBg": "rgba(25, 24, 35, 0.85)"
      }
    },
    "Apple Music Sing": {
      "name": "Apple Music Sing",
      "mode": "dark",
      "accentColor": "#FA243C",
      "customColors": {
        "bgBase": "#17091A",
        "bgElevated": "#230F27",
        "bgSurface": "#2E1433",
        "bgHighlight": "rgba(255, 255, 255, 0.10)",
        "textPrimary": "#FFFFFF",
        "textSecondary": "rgba(240, 220, 245, 0.65)",
        "textSubdued": "rgba(240, 220, 245, 0.35)",
        "borderColor": "rgba(255, 255, 255, 0.08)",
        "sidebarBg": "rgba(23, 9, 26, 0.78)",
        "playerBg": "rgba(28, 11, 32, 0.85)"
      }
    }
  },
  "customCss": "/* ============================================================\n   Apple Music Theme Skin (Engine v2)\n   Source of Truth: DESIGN.md (Target: 90%+ match)\n   ============================================================ */\n\n/* ------------------------------------------------------------\n   2. COLOR TOKENS & TYPOGRAPHY\n   ------------------------------------------------------------ */\n:root {\n  /* Accent Tokens */\n  --am-red: #fa243c;\n  --am-green: #34c759;\n  --am-danger: #ff453a;\n\n  /* Dark Theme Tokens */\n  --am-bg: #1e1e1e;\n  --am-bg-elevated: #2a2a2c;\n  --am-sidebar: rgba(30, 30, 30, 0.72);\n  --am-text: #ffffff;\n  --am-text-2: rgba(235, 235, 245, 0.60);\n  --am-text-3: rgba(235, 235, 245, 0.30);\n  --am-fill: rgba(255, 255, 255, 0.10);\n  --am-fill-hover: rgba(255, 255, 255, 0.16);\n  --am-separator: rgba(255, 255, 255, 0.08);\n  --am-stripe: rgba(255, 255, 255, 0.03);\n\n  /* Fallback aliases for app components */\n  --skin-accent: var(--am-red);\n  --skin-bg-base: var(--am-bg);\n  --skin-bg-elevated: var(--am-bg-elevated);\n  --skin-sidebar-bg: var(--am-sidebar);\n  --skin-text-primary: var(--am-text);\n  --skin-text-secondary: var(--am-text-2);\n  --skin-text-subdued: var(--am-text-3);\n  --skin-border: var(--am-separator);\n  --skin-player-bg: rgba(30, 30, 30, 0.85);\n\n  /* 3. Typography Stack */\n  font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", \"Helvetica Neue\", \"Segoe UI\", Roboto, system-ui, sans-serif !important;\n  -webkit-font-smoothing: antialiased !important;\n}\n\n:root[data-theme=\"light\"] {\n  /* Light Theme Tokens */\n  --am-bg: #ffffff;\n  --am-bg-elevated: #f6f6f6;\n  --am-sidebar: rgba(246, 246, 246, 0.78);\n  --am-text: #1d1d1f;\n  --am-text-2: rgba(60, 60, 67, 0.60);\n  --am-text-3: rgba(60, 60, 67, 0.30);\n  --am-fill: rgba(0, 0, 0, 0.06);\n  --am-fill-hover: rgba(0, 0, 0, 0.10);\n  --am-separator: rgba(0, 0, 0, 0.08);\n  --am-stripe: rgba(0, 0, 0, 0.025);\n\n  --skin-accent: var(--am-red);\n  --skin-bg-base: var(--am-bg);\n  --skin-bg-elevated: var(--am-bg-elevated);\n  --skin-sidebar-bg: var(--am-sidebar);\n  --skin-text-primary: var(--am-text);\n  --skin-text-secondary: var(--am-text-2);\n  --skin-text-subdued: var(--am-text-3);\n  --skin-border: var(--am-separator);\n  --skin-player-bg: rgba(246, 246, 246, 0.85);\n}\n\n/* ------------------------------------------------------------\n   5.1 TITLEBAR & SEARCH\n   ------------------------------------------------------------ */\n.titlebar {\n  background: color-mix(in srgb, var(--am-bg) 78%, transparent) !important;\n  backdrop-filter: blur(30px) saturate(180%) !important;\n  -webkit-backdrop-filter: blur(30px) saturate(180%) !important;\n  border-bottom: 1px solid var(--am-separator) !important;\n  box-shadow: none !important;\n}\n\n.search-input-wrapper {\n  background: var(--am-fill) !important;\n  border: none !important;\n  border-radius: 8px !important;\n  height: 28px !important;\n  padding: 0 10px !important;\n  transition: box-shadow 140ms ease !important;\n}\n\n.search-wrapper-outer:focus-within .search-input-wrapper {\n  background: var(--am-fill) !important;\n  border: none !important;\n  box-shadow: 0 0 0 3px rgba(250, 36, 60, 0.25) !important;\n}\n\n.search-input {\n  font-size: 13px !important;\n  color: var(--am-text) !important;\n}\n\n.search-input::placeholder {\n  color: var(--am-text-3) !important;\n}\n\n.nav-btn {\n  background: transparent !important;\n  border: none !important;\n  border-radius: 50% !important;\n  color: var(--am-text-2) !important;\n  transition: background-color 140ms ease, color 140ms ease !important;\n  transform: none !important;\n}\n\n.nav-btn:hover {\n  background: var(--am-fill) !important;\n  color: var(--am-text) !important;\n  transform: none !important;\n}\n\n/* ------------------------------------------------------------\n   5.2 SIDEBAR\n   ------------------------------------------------------------ */\n.sidebar {\n  background: var(--am-sidebar) !important;\n  backdrop-filter: blur(30px) saturate(180%) !important;\n  -webkit-backdrop-filter: blur(30px) saturate(180%) !important;\n  border-right: 1px solid var(--am-separator) !important;\n  box-shadow: none !important;\n}\n\n.nav-section-title {\n  font-size: 11px !important;\n  font-weight: 600 !important;\n  letter-spacing: 0.02em !important;\n  text-transform: none !important;\n  color: var(--am-text-3) !important;\n  padding: 12px 14px 4px 14px !important;\n}\n\n.nav-item {\n  border-radius: 6px !important;\n  margin: 1px 8px !important;\n  padding: 6px 10px !important;\n  font-size: 13px !important;\n  font-weight: 400 !important;\n  color: var(--am-text) !important;\n  transition: background-color 140ms ease, color 140ms ease !important;\n  transform: none !important;\n}\n\n.nav-item:hover:not(.active) {\n  background-color: color-mix(in srgb, var(--am-fill) 50%, transparent) !important;\n  color: var(--am-text) !important;\n  transform: none !important;\n}\n\n/* Neutral gray selection, red icon only */\n.nav-item.active {\n  background-color: var(--am-fill) !important;\n  color: var(--am-text) !important;\n  font-weight: 500 !important;\n  transform: none !important;\n}\n\n.nav-item.active svg,\n.nav-item.active .icon,\n.nav-item.active :global(svg) {\n  color: var(--am-red) !important;\n}\n\n.nav-count {\n  font-size: 11px !important;\n  font-weight: 400 !important;\n  color: var(--am-text-3) !important;\n  background: transparent !important;\n  border-radius: 0 !important;\n  padding: 0 !important;\n}\n\n/* ------------------------------------------------------------\n   5.3 ARTWORK CARDS (Grids, Home, Discover, Search)\n   ------------------------------------------------------------ */\n.media-card, .card {\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  transform: none !important;\n  transition: opacity 140ms ease !important;\n  padding: 0 !important;\n}\n\n.media-card:hover, .card:hover {\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  transform: none !important;\n}\n\n/* Shadow lives on the artwork only */\n.media-card .cover, .card .cover, .cover {\n  border-radius: 6px !important;\n  aspect-ratio: 1 !important;\n  overflow: hidden !important;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25) !important;\n  border: none !important;\n  transition: filter 140ms ease !important;\n}\n\n:root[data-theme=\"light\"] .media-card .cover,\n:root[data-theme=\"light\"] .card .cover,\n:root[data-theme=\"light\"] .cover {\n  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.18) !important;\n}\n\n.media-card .card-title, .card .card-title, .carousel-card-wrapper .card-title {\n  font-size: 13px !important;\n  font-weight: 500 !important;\n  color: var(--am-text) !important;\n  margin-top: 8px !important;\n  white-space: nowrap !important;\n  overflow: hidden !important;\n  text-overflow: ellipsis !important;\n}\n\n.media-card .card-subtitle, .card .card-subtitle, .carousel-card-wrapper .card-subtitle {\n  font-size: 12px !important;\n  font-weight: 400 !important;\n  color: var(--am-text-2) !important;\n  margin-top: 2px !important;\n  white-space: nowrap !important;\n  overflow: hidden !important;\n  text-overflow: ellipsis !important;\n}\n\n.play-button {\n  background-color: rgba(255, 255, 255, 0.95) !important;\n  color: #1d1d1f !important;\n  border-radius: 50% !important;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3) !important;\n  transform: none !important;\n}\n\n.badge {\n  background: var(--am-fill) !important;\n  color: var(--am-text) !important;\n  border-radius: 4px !important;\n  font-size: 10px !important;\n  font-weight: 600 !important;\n}\n\n/* ------------------------------------------------------------\n   5.4 DETAIL HEADERS (Album, Artist, Playlist, Liked Songs)\n   ------------------------------------------------------------ */\n.album-header,\n.artist-header,\n.playlist-header,\n.liked-header {\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n  padding: 0 !important;\n  margin-bottom: 24px !important;\n}\n\n.liked-header {\n  background: linear-gradient(180deg, rgba(250, 36, 60, 0.10) 0px, transparent 240px) !important;\n}\n\n.album-cover,\n.playlist-cover,\n.liked-header .cover-art {\n  border-radius: 8px !important;\n  overflow: hidden !important;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.30) !important;\n  border: none !important;\n}\n\n.artist-avatar, .artist-picture {\n  border-radius: 50% !important;\n  overflow: hidden !important;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.30) !important;\n  border: none !important;\n}\n\n.album-title,\n.playlist-title,\n.liked-title {\n  font-size: 28px !important;\n  font-weight: 700 !important;\n  letter-spacing: -0.02em !important;\n  line-height: 1.2 !important;\n  color: var(--am-text) !important;\n  margin: 4px 0 6px 0 !important;\n}\n\n.artist-name {\n  font-size: 32px !important;\n  font-weight: 700 !important;\n  letter-spacing: -0.02em !important;\n  line-height: 1.15 !important;\n  color: var(--am-text) !important;\n  margin: 4px 0 6px 0 !important;\n}\n\n.album-artist.link,\n.album-meta .link {\n  font-size: 20px !important;\n  font-weight: 500 !important;\n  color: var(--am-red) !important;\n  text-decoration: none !important;\n}\n\n.album-meta,\n.artist-meta,\n.playlist-meta {\n  font-size: 12px !important;\n  font-weight: 400 !important;\n  color: var(--am-text-2) !important;\n}\n\n.album-type,\n.artist-type,\n.playlist-type {\n  font-size: 12px !important;\n  font-weight: 600 !important;\n  color: var(--am-text-2) !important;\n  text-transform: none !important;\n  letter-spacing: 0 !important;\n}\n\n/* ------------------------------------------------------------\n   5.5 BUTTONS\n   ------------------------------------------------------------ */\n.album-actions .play-all-btn,\n.artist-actions .play-all-btn,\n.playlist-actions .play-all-btn,\n.liked-controls .play-all-btn,\n.liked-controls .shuffle-btn {\n  height: 32px !important;\n  line-height: 32px !important;\n  border-radius: 8px !important;\n  padding: 0 20px !important;\n  background: var(--am-fill) !important;\n  color: var(--am-red) !important;\n  font-size: 13px !important;\n  font-weight: 600 !important;\n  border: none !important;\n  box-shadow: none !important;\n  transform: none !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  gap: 6px !important;\n  transition: background-color 140ms ease, opacity 140ms ease !important;\n}\n\n.album-actions .play-all-btn svg,\n.artist-actions .play-all-btn svg,\n.playlist-actions .play-all-btn svg,\n.liked-controls .play-all-btn svg,\n.liked-controls .shuffle-btn svg,\n.album-actions .play-all-btn :global(svg),\n.artist-actions .play-all-btn :global(svg),\n.playlist-actions .play-all-btn :global(svg),\n.liked-controls .play-all-btn :global(svg),\n.liked-controls .shuffle-btn :global(svg) {\n  color: var(--am-red) !important;\n}\n\n.album-actions .play-all-btn:hover,\n.artist-actions .play-all-btn:hover,\n.playlist-actions .play-all-btn:hover,\n.liked-controls .play-all-btn:hover,\n.liked-controls .shuffle-btn:hover {\n  background: var(--am-fill-hover) !important;\n  transform: none !important;\n  box-shadow: none !important;\n}\n\n.album-actions .play-all-btn:active,\n.artist-actions .play-all-btn:active,\n.playlist-actions .play-all-btn:active,\n.liked-controls .play-all-btn:active,\n.liked-controls .shuffle-btn:active {\n  opacity: 0.8 !important;\n  transform: none !important;\n}\n\n.album-actions .download-btn,\n.artist-actions .download-btn,\n.playlist-actions .download-btn,\n.playlist-actions .add-songs-btn {\n  height: 32px !important;\n  line-height: 32px !important;\n  border-radius: 8px !important;\n  padding: 0 16px !important;\n  background: var(--am-fill) !important;\n  color: var(--am-text) !important;\n  font-size: 13px !important;\n  font-weight: 500 !important;\n  border: none !important;\n  box-shadow: none !important;\n  transform: none !important;\n  transition: background-color 140ms ease !important;\n}\n\n.album-actions .download-btn:hover,\n.artist-actions .download-btn:hover,\n.playlist-actions .download-btn:hover,\n.playlist-actions .add-songs-btn:hover {\n  background: var(--am-fill-hover) !important;\n  transform: none !important;\n}\n\n.back-btn {\n  width: 32px !important;\n  height: 32px !important;\n  border-radius: 50% !important;\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  color: var(--am-text) !important;\n  transform: none !important;\n  transition: background-color 140ms ease !important;\n}\n\n.back-btn:hover {\n  background: var(--am-fill) !important;\n  transform: none !important;\n}\n\n.load-more {\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  color: var(--am-red) !important;\n  font-size: 13px !important;\n  font-weight: 600 !important;\n  padding: 8px 16px !important;\n  margin: 16px auto !important;\n  display: block !important;\n  transform: none !important;\n  transition: opacity 140ms ease !important;\n}\n\n.load-more:hover {\n  opacity: 0.8 !important;\n  background: transparent !important;\n  transform: none !important;\n}\n\n/* ------------------------------------------------------------\n   5.6 SEGMENTED TABS & CHIPS\n   ------------------------------------------------------------ */\n.artist-detail .tabs,\n.plugin-view .tabs {\n  background: var(--am-fill) !important;\n  border-radius: 9999px !important;\n  padding: 2px !important;\n  display: inline-flex !important;\n  border: none !important;\n  margin-bottom: 20px !important;\n}\n\n.artist-detail .tab,\n.plugin-view .tab {\n  border-radius: 9999px !important;\n  padding: 5px 16px !important;\n  font-size: 13px !important;\n  font-weight: 500 !important;\n  border: none !important;\n  color: var(--am-text-2) !important;\n  background: transparent !important;\n  transition: background-color 140ms ease, color 140ms ease !important;\n}\n\n.artist-detail .tab.active,\n.plugin-view .tab.active {\n  background: #ffffff !important;\n  color: #1d1d1f !important;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18) !important;\n  font-weight: 600 !important;\n}\n\n:root[data-theme=\"light\"] .artist-detail .tab.active,\n:root[data-theme=\"light\"] .plugin-view .tab.active {\n  background: #ffffff !important;\n  color: #1d1d1f !important;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12) !important;\n}\n\n.section-pill,\n.category-chip {\n  background: var(--am-fill) !important;\n  border: none !important;\n  border-radius: 9999px !important;\n  padding: 5px 14px !important;\n  font-size: 12px !important;\n  font-weight: 500 !important;\n  color: var(--am-text-2) !important;\n  transition: background-color 140ms ease, color 140ms ease !important;\n}\n\n.section-pill.active,\n.section-pill[aria-pressed=\"true\"],\n.category-chip.active {\n  background: #ffffff !important;\n  color: #1d1d1f !important;\n  border: none !important;\n  font-weight: 600 !important;\n}\n\n:root[data-theme=\"light\"] .section-pill.active,\n:root[data-theme=\"light\"] .section-pill[aria-pressed=\"true\"],\n:root[data-theme=\"light\"] .category-chip.active {\n  background: #1d1d1f !important;\n  color: #ffffff !important;\n}\n\n/* ------------------------------------------------------------\n   5.7 PLAYER\n   ------------------------------------------------------------ */\n.player-bar {\n  background: color-mix(in srgb, var(--am-bg) 78%, transparent) !important;\n  backdrop-filter: blur(30px) saturate(180%) !important;\n  -webkit-backdrop-filter: blur(30px) saturate(180%) !important;\n  border-top: 1px solid var(--am-separator) !important;\n  box-shadow: none !important;\n}\n\n/* Bare glyph, no circle, no red fill, no glow */\n.player-bar .play-btn {\n  background: transparent !important;\n  border-radius: 0 !important;\n  box-shadow: none !important;\n  width: auto !important;\n  height: auto !important;\n  padding: 6px !important;\n  border: none !important;\n  color: var(--am-text) !important;\n  transform: none !important;\n  transition: opacity 140ms ease !important;\n}\n\n.player-bar .play-btn:hover {\n  opacity: 0.8 !important;\n  transform: none !important;\n  box-shadow: none !important;\n}\n\n.player-bar .play-btn:active {\n  opacity: 0.6 !important;\n  transform: none !important;\n}\n\n.controls-buttons .icon-btn {\n  background: transparent !important;\n  border: none !important;\n  color: var(--am-text-2) !important;\n  transform: none !important;\n  transition: color 140ms ease !important;\n}\n\n.controls-buttons .icon-btn:hover {\n  color: var(--am-text) !important;\n  transform: none !important;\n}\n\n.controls-buttons .icon-btn.active,\n.controls-buttons .icon-btn.active svg,\n.controls-buttons .icon-btn.active :global(svg) {\n  color: var(--am-red) !important;\n}\n\n/* Progress bar: 3px tall, track --am-fill, fill white at 80% (NOT RED!) */\n.progress-bar {\n  height: 3px !important;\n  border-radius: 2px !important;\n  background-color: var(--am-fill) !important;\n  transition: none !important;\n}\n\n.progress-bar:hover, .progress-bar.seeking {\n  height: 3px !important;\n}\n\n.progress-fill {\n  border-radius: 2px !important;\n  background: rgba(255, 255, 255, 0.80) !important;\n}\n\n:root[data-theme=\"light\"] .progress-fill {\n  background: rgba(0, 0, 0, 0.70) !important;\n}\n\n.progress-thumb {\n  width: 8px !important;\n  height: 8px !important;\n  border-radius: 50% !important;\n  background: #ffffff !important;\n  box-shadow: none !important;\n  opacity: 0 !important;\n  transform: none !important;\n  transition: opacity 120ms ease !important;\n}\n\n:root[data-theme=\"light\"] .progress-thumb {\n  background: #1d1d1f !important;\n}\n\n.progress-bar:hover .progress-thumb,\n.progress-bar.seeking .progress-thumb {\n  opacity: 1 !important;\n  transform: none !important;\n}\n\n.album-art {\n  border-radius: 4px !important;\n  box-shadow: none !important;\n}\n\n.volume-bar {\n  height: 3px !important;\n  border-radius: 2px !important;\n  background-color: var(--am-fill) !important;\n}\n\n.volume-fill {\n  border-radius: 2px !important;\n  background: rgba(255, 255, 255, 0.80) !important;\n}\n\n:root[data-theme=\"light\"] .volume-fill {\n  background: rgba(0, 0, 0, 0.70) !important;\n}\n\n/* ------------------------------------------------------------\n   5.8 TRACK LISTS\n   ------------------------------------------------------------ */\n.track-row {\n  min-height: 36px !important;\n  border-radius: 6px !important;\n  margin: 0 !important;\n  border: none !important;\n  background: transparent !important;\n  transition: background-color 120ms ease !important;\n}\n\n.track-row:nth-child(even) {\n  background-color: var(--am-stripe) !important;\n}\n\n.track-row:hover {\n  background-color: color-mix(in srgb, var(--am-fill) 60%, transparent) !important;\n}\n\n/* Playing row: NO background tint, red title only */\n.track-row.playing {\n  background-color: transparent !important;\n}\n\n.track-row.playing:nth-child(even) {\n  background-color: var(--am-stripe) !important;\n}\n\n.track-row.playing:hover {\n  background-color: color-mix(in srgb, var(--am-fill) 60%, transparent) !important;\n}\n\n.track-row.playing .track-name {\n  color: var(--am-red) !important;\n  font-weight: 500 !important;\n}\n\n.track-row.playing .equalizer-bars .eq-bar {\n  background-color: var(--am-red) !important;\n}\n\n.track-list-header {\n  font-size: 11px !important;\n  font-weight: 600 !important;\n  color: var(--am-text-3) !important;\n  border-bottom: 1px solid var(--am-separator) !important;\n  text-transform: none !important;\n}\n\n.disc-header {\n  font-size: 12px !important;\n  font-weight: 600 !important;\n  color: var(--am-text-2) !important;\n  text-transform: none !important;\n  letter-spacing: 0 !important;\n  border-bottom: 1px solid var(--am-separator) !important;\n  padding-bottom: 6px !important;\n  margin-bottom: 6px !important;\n}\n\n.quality-tag {\n  color: var(--am-text-2) !important;\n  background: var(--am-fill) !important;\n  border-radius: 4px !important;\n  border: none !important;\n  font-size: 10px !important;\n  font-weight: 500 !important;\n}\n\n.quality-tag.high-quality {\n  color: var(--am-red) !important;\n  background: color-mix(in srgb, var(--am-red) 12%, transparent) !important;\n  border: none !important;\n}\n\n/* ------------------------------------------------------------\n   5.9 MENUS & DROPDOWNS\n   ------------------------------------------------------------ */\n.context-menu,\n.dropdown-menu {\n  background: rgba(40, 40, 42, 0.82) !important;\n  backdrop-filter: blur(30px) saturate(180%) !important;\n  -webkit-backdrop-filter: blur(30px) saturate(180%) !important;\n  border: 0.5px solid var(--am-separator) !important;\n  border-radius: 10px !important;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35) !important;\n  padding: 4px !important;\n}\n\n:root[data-theme=\"light\"] .context-menu,\n:root[data-theme=\"light\"] .dropdown-menu {\n  background: rgba(246, 246, 246, 0.85) !important;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;\n}\n\n.menu-item,\n.dropdown-item {\n  border-radius: 5px !important;\n  padding: 5px 10px !important;\n  font-size: 13px !important;\n  font-weight: 400 !important;\n  color: var(--am-text) !important;\n  transition: background-color 100ms ease, color 100ms ease !important;\n}\n\n.menu-item:hover,\n.dropdown-item:hover {\n  background-color: var(--am-red) !important;\n  color: #ffffff !important;\n}\n\n.dropdown-item.danger {\n  color: var(--am-danger) !important;\n}\n\n.dropdown-item.danger:hover {\n  background-color: var(--am-red) !important;\n  color: #ffffff !important;\n}\n\n.menu-separator,\n.dropdown-separator {\n  height: 1px !important;\n  background-color: var(--am-separator) !important;\n  margin: 4px 6px !important;\n}\n\n/* ------------------------------------------------------------\n   5.10 SETTINGS\n   ------------------------------------------------------------ */\n.settings-sidebar {\n  background: var(--am-sidebar) !important;\n  border-right: 1px solid var(--am-separator) !important;\n}\n\n.settings-search-input {\n  border-radius: 8px !important;\n  background: var(--am-fill) !important;\n  border: none !important;\n  padding: 6px 12px 6px 28px !important;\n  color: var(--am-text) !important;\n}\n\n.settings-search-input:focus {\n  box-shadow: 0 0 0 3px rgba(250, 36, 60, 0.25) !important;\n}\n\n.sidebar-tab-btn {\n  border-radius: 6px !important;\n  padding: 6px 10px !important;\n  margin: 1px 8px !important;\n  color: var(--am-text) !important;\n  transition: background-color 140ms ease !important;\n}\n\n.sidebar-tab-btn:hover:not(.active) {\n  background-color: color-mix(in srgb, var(--am-fill) 50%, transparent) !important;\n}\n\n.sidebar-tab-btn.active {\n  background-color: var(--am-fill) !important;\n  color: var(--am-text) !important;\n}\n\n.sidebar-tab-btn.active .tab-icon-wrap,\n.sidebar-tab-btn.active :global(svg) {\n  color: var(--am-red) !important;\n}\n\n.category-title {\n  font-size: 28px !important;\n  font-weight: 700 !important;\n  letter-spacing: -0.02em !important;\n  color: var(--am-text) !important;\n}\n\n.category-subtitle {\n  font-size: 13px !important;\n  color: var(--am-text-2) !important;\n}\n\n.settings-card,\n.settings-section,\n.inner-section {\n  background: color-mix(in srgb, var(--am-fill) 50%, transparent) !important;\n  border: none !important;\n  border-radius: 10px !important;\n  padding: 16px !important;\n  margin-bottom: 16px !important;\n  box-shadow: none !important;\n}\n\n.toggle-btn {\n  width: 38px !important;\n  height: 22px !important;\n  border-radius: 9999px !important;\n  background-color: var(--am-fill-hover) !important;\n  border: none !important;\n  transition: background-color 180ms ease !important;\n  position: relative !important;\n}\n\n.toggle-btn.active {\n  background-color: var(--am-green) !important;\n}\n\n/* ------------------------------------------------------------\n   5.11 FULLSCREEN PLAYER & LYRICS\n   ------------------------------------------------------------ */\n.fullscreen-player .lyric-line {\n  filter: blur(2.5px) !important;\n  opacity: 0.35 !important;\n  font-size: 34px !important;\n  font-weight: 700 !important;\n  text-align: left !important;\n  transform: none !important;\n  transition: filter 220ms ease, opacity 220ms ease !important;\n}\n\n.fullscreen-player .lyric-line:hover {\n  filter: blur(0px) !important;\n  opacity: 0.75 !important;\n}\n\n.fullscreen-player .lyric-line.current,\n.fullscreen-player .lyric-line.active {\n  filter: blur(0px) !important;\n  opacity: 1 !important;\n  transform: scale(1.04) !important;\n  font-weight: 700 !important;\n  color: #ffffff !important;\n  text-shadow: 0 0 16px rgba(255, 255, 255, 0.15) !important;\n}\n\n/* ------------------------------------------------------------\n   5.12 MOBILE\n   ------------------------------------------------------------ */\n.bottom-nav {\n  background: var(--am-sidebar) !important;\n  backdrop-filter: blur(30px) saturate(180%) !important;\n  -webkit-backdrop-filter: blur(30px) saturate(180%) !important;\n  border-top: 1px solid var(--am-separator) !important;\n  box-shadow: none !important;\n}\n\n.bottom-nav .nav-item {\n  color: var(--am-text-2) !important;\n  font-size: 10px !important;\n}\n\n.bottom-nav .nav-item.active {\n  color: var(--am-red) !important;\n}\n\n.bottom-nav .nav-item.active svg,\n.bottom-nav .nav-item.active :global(svg) {\n  color: var(--am-red) !important;\n}\n\n.mobile-mini-player {\n  background: var(--am-bg-elevated) !important;\n  backdrop-filter: blur(30px) !important;\n  border-radius: 12px !important;\n  border: none !important;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;\n}\n\n.mini-progress-fill {\n  background-color: rgba(255, 255, 255, 0.85) !important;\n}\n\n:root[data-theme=\"light\"] .mini-progress-fill {\n  background-color: rgba(0, 0, 0, 0.75) !important;\n}\n\n/* ------------------------------------------------------------\n   6. MOTION & 7. SHADOWS\n   ------------------------------------------------------------ */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n::-webkit-scrollbar {\n  width: 8px !important;\n  height: 8px !important;\n}\n\n::-webkit-scrollbar-track {\n  background: transparent !important;\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--am-fill) !important;\n  border-radius: 9999px !important;\n  border: 2px solid transparent !important;\n  background-clip: padding-box !important;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--am-fill-hover) !important;\n  border-radius: 9999px !important;\n  border: 2px solid transparent !important;\n  background-clip: padding-box !important;\n}",
  "customJs": "// Apple Music Dynamic 5-Blob Chromatic Fluid Mesh\nlet rafId = null;\nlet t = 0;\nconst blobs = [\n  { x: 0.25, y: 0.3, r: 0.52, color: 'rgba(250, 36, 60, 0.28)', s: 0.0007, ph: 0 },\n  { x: 0.75, y: 0.35, r: 0.58, color: 'rgba(255, 45, 85, 0.24)', s: 0.0006, ph: 2.1 },\n  { x: 0.5, y: 0.75, r: 0.62, color: 'rgba(123, 44, 191, 0.22)', s: 0.0005, ph: 4.2 },\n  { x: 0.85, y: 0.8, r: 0.48, color: 'rgba(255, 107, 74, 0.20)', s: 0.0008, ph: 1.2 },\n  { x: 0.15, y: 0.7, r: 0.50, color: 'rgba(225, 29, 72, 0.22)', s: 0.0006, ph: 3.5 }\n];\n\nfunction draw() {\n  t += 1;\n  const w = canvas.width;\n  const h = canvas.height;\n  ctx.clearRect(0, 0, w, h);\n  for (let i = 0; i < blobs.length; i++) {\n    const b = blobs[i];\n    const cx = (b.x + Math.sin(t * b.s + b.ph) * 0.14) * w;\n    const cy = (b.y + Math.cos(t * (b.s * 1.1) + b.ph) * 0.14) * h;\n    const rad = b.r * Math.min(w, h);\n    const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, rad);\n    grad.addColorStop(0, b.color);\n    grad.addColorStop(1, 'transparent');\n    ctx.fillStyle = grad;\n    ctx.beginPath();\n    ctx.arc(cx, cy, rad, 0, Math.PI * 2);\n    ctx.fill();\n  }\n  rafId = requestAnimationFrame(draw);\n}\ndraw();\nreturn () => { if (rafId) cancelAnimationFrame(rafId); };"
}