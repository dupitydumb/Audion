{
  "version": 2,
  "name": "Winamp Classic",
  "author": "Audion Community",
  "description": "Legendary 1998 Winamp Hi-Fi retro audio deck with brushed metallic chassis, glowing green 7-segment digital LCD timers, segmented LED meters, chunky beveled 3D controls, and animated spectrum analyzer visualizer.",
  "accentColor": "#00FF41",
  "mode": "dark",
  "customColors": {
    "bgBase": "#14161B",
    "bgElevated": "#1C1E24",
    "bgSurface": "#262932",
    "bgHighlight": "rgba(0, 255, 65, 0.12)",
    "textPrimary": "#E2E8F0",
    "textSecondary": "#A0AEC0",
    "textSubdued": "#718096",
    "borderColor": "#363A45",
    "sidebarBg": "#181A20",
    "playerBg": "#1F232B"
  },
  "background": {
    "type": "none",
    "value": "",
    "opacity": 1,
    "blur": 0,
    "fixed": false
  },
  "animation": {
    "reducedMotion": false,
    "pageTransition": "fade",
    "playerVisualization": "bars",
    "hoverScale": false,
    "accentPulse": false,
    "transitionSpeed": "fast"
  },
  "activeScheme": "Classic Titanium",
  "schemes": {
    "Classic Titanium": {
      "name": "Classic Titanium",
      "mode": "dark",
      "accentColor": "#00FF41",
      "customColors": {
        "bgBase": "#14161B",
        "bgElevated": "#1C1E24",
        "bgSurface": "#262932",
        "bgHighlight": "rgba(0, 255, 65, 0.12)",
        "textPrimary": "#E2E8F0",
        "textSecondary": "#A0AEC0",
        "textSubdued": "#718096",
        "borderColor": "#363A45",
        "sidebarBg": "#181A20",
        "playerBg": "#1F232B"
      }
    },
    "Emerald Hi-Fi": {
      "name": "Emerald Hi-Fi",
      "mode": "dark",
      "accentColor": "#10B981",
      "customColors": {
        "bgBase": "#09120D",
        "bgElevated": "#0E1C14",
        "bgSurface": "#14281E",
        "bgHighlight": "rgba(16, 185, 129, 0.14)",
        "textPrimary": "#ECFDF5",
        "textSecondary": "#A7F3D0",
        "textSubdued": "#6EE7B7",
        "borderColor": "#1E3A2B",
        "sidebarBg": "#0C1811",
        "playerBg": "#122419"
      }
    },
    "Solar Gold": {
      "name": "Solar Gold",
      "mode": "dark",
      "accentColor": "#F59E0B",
      "customColors": {
        "bgBase": "#16130D",
        "bgElevated": "#211D14",
        "bgSurface": "#2E281C",
        "bgHighlight": "rgba(245, 158, 11, 0.14)",
        "textPrimary": "#FFFBEB",
        "textSecondary": "#FDE68A",
        "textSubdued": "#D97706",
        "borderColor": "#3D3425",
        "sidebarBg": "#1A1710",
        "playerBg": "#252016"
